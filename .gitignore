# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
Ship_Drift/SourceArt/**/*.png
Ship_Drift/SourceArt/**/*.tga

# Binary Files
Ship_Drift/Binaries/*
Ship_Drift/Plugins/**/Binaries/*

# Builds
Ship_Drift/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Ship_Drift/Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Ship_Drift/Saved/*

# Compiled source files for the engine to use
Ship_Drift/Intermediate/*
Ship_Drift/Plugins/**/Intermediate/*

# Cache files for the editor to use
Ship_Drift/DerivedDataCache/*
Ship_Drift/Saved/Logs/Ship_Drift.log
